# Copie para .env e ajuste os valores. O .env é ignorado pelo Git.

# Segredo usado para assinar e verificar os tokens JWT.
# Gere um valor novo, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Obrigatório em produção (a API falha ao iniciar sem ele).
# NODE_ENV=production

# URL base da API usada pelo frontend (padrão: http://localhost:3001).
# VITE_API_URL=http://localhost:3001
